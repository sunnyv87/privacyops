# ──────────────────────────────────────────────────────────────
# TechD PrivacyOps — Environment Variables
# Copy to .env.local and fill in values
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://privacyops:privacyops_dev@localhost:5432/privacyops

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:privacyops_dev@localhost:6379

# ── OpenSearch ────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── NATS ──────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Temporal ──────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=privacyops

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Keycloak (OIDC) ──────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=privacyops
KEYCLOAK_CLIENT_ID=privacyops-api
KEYCLOAK_CLIENT_SECRET=

# ── Object Storage (MinIO in dev, S3 in prod) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=privacyops-data
S3_ACCESS_KEY=privacyops
S3_SECRET_KEY=privacyops_dev

# ── KMS ───────────────────────────────────────────────────────
KMS_KEY_ARN=

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Notifications ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@privacyops.techd.com

WEBHOOK_SIGNING_SECRET=change-me

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
