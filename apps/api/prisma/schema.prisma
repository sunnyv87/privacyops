// ============================================================================
// AI Governance (Module 20)
// ============================================================================

model AiSystem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String    @db.VarChar(255)
  type             String    @db.VarChar(50) // ml_model, llm, recommendation, classification
  riskCategory     String    @map("risk_category") @db.VarChar(50) // unacceptable, high, limited, minimal
  status           String    @default("development") @db.VarChar(50) // active, development, deprecated, retired
  ownerId          String    @map("owner_id") @db.Uuid
  description      String?   @db.Text
  trainingDatasets Json      @map("training_datasets") // [{assetId, dataTypes, consentBasis}]
  purpose          String?   @db.Text
  regulatoryBasis  Json?     @map("regulatory_basis") // [{regulation, article, compliance_status}]
  lastAuditedAt    DateTime? @map("last_audited_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  datasetUsages AiDatasetUsage[]

  @@index([tenantId])
  @@index([riskCategory])
  @@map("ai_systems")
}

model AiDatasetUsage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  aiSystemId     String    @map("ai_system_id") @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  usageType      String    @map("usage_type") @db.VarChar(50) // training, validation, inference, fine_tuning
  dataCategories Json      @map("data_categories")
  consentBasis   String?   @map("consent_basis") @db.VarChar(50)
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  aiSystem AiSystem @relation(fields: [aiSystemId], references: [id])

  @@index([tenantId])
  @@index([aiSystemId])
  @@index([assetId])
  @@map("ai_dataset_usage")
}
