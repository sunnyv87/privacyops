  updatedAt DateTime @updatedAt @map("updated_at")

  outgoingEdges DataGraphEdge[] @relation("EdgeSource")
  incomingEdges DataGraphEdge[] @relation("EdgeTarget")

  @@unique([tenantId, nodeType, entityId])
  @@index([tenantId, nodeType])
  @@map("data_graph_nodes")
}

model DataGraphEdge {
