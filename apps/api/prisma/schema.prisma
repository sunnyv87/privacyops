model DataGraphNode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nodeType  String   @map("node_type") @db.VarChar(50) // asset, dataset, column, identity, vendor, ai_system, processing_activity, retention_policy
  entityId  String   @map("entity_id") @db.Uuid
