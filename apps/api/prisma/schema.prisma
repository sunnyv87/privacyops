// TechD PrivacyOps Platform — Database Schema
// PostgreSQL with Row Level Security for multi-tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE: Tenancy & Identity
// ============================================================================

model Tenant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(255)
  slug                String   @unique @db.VarChar(100)
  domain              String?  @db.VarChar(255)
  subscriptionTier    String   @default("trial") @map("subscription_tier") @db.VarChar(50)
  status              String   @default("trial") @db.VarChar(50) // active, suspended, trial, deactivated
  settings            Json?
  dataResidencyRegion String   @map("data_residency_region") @db.VarChar(50)
  encryptionKeyId     String   @map("encryption_key_id") @db.VarChar(255)
  trialExpiresAt      DateTime? @map("trial_expires_at")
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  dataSources DataSource[]
  roles       Role[]

  @@map("tenants")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @db.VarChar(255)
  name         String    @db.VarChar(255)
  status       String    @default("invited") @db.VarChar(50) // active, invited, disabled
  authProvider String    @default("local") @map("auth_provider") @db.VarChar(50)
  externalId   String?   @map("external_id") @db.VarChar(255)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes    Json?     @map("mfa_recovery_codes") // Encrypted string array
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  preferences         Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([externalId])
  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid // null = system role
  name        String  @db.VarChar(100)
  slug        String  @db.VarChar(100)
  description String? @db.Text
  permissions Json    // Array of permission strings
  isSystem    Boolean @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model UserRole {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  scope  Json?  // Optional scope restrictions

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// DSPM: Data Sources & Connectors
// ============================================================================

model DataSource {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String    @db.VarChar(255)
  type             String    @db.VarChar(50) // aws_s3, postgresql, etc.
  status           String    @default("pending_setup") @db.VarChar(50)
  connectionConfig Json      @map("connection_config") // Encrypted
  authMethod       String    @map("auth_method") @db.VarChar(50)
  lastConnectedAt  DateTime? @map("last_connected_at")
  lastScanAt       DateTime? @map("last_scan_at")
  scanSchedule     String?   @map("scan_schedule") @db.VarChar(50) // Cron
  metadata         Json?
  tags             Json?     @default("[]") // String array
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  rateLimitConfig  Json?     @map("rate_limit_config")   // {maxRequestsPerSecond, burstLimit}
  retryConfig      Json?     @map("retry_config")        // {maxRetries, backoffMs}
  lastHealthCheck  DateTime? @map("last_health_check")
  healthStatus     String?   @map("health_status") @db.VarChar(50) // healthy, degraded, unhealthy
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  assets   Asset[]
  scanJobs ScanJob[]

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@map("data_sources")
}

model ScanJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  dataSourceId String    @map("data_source_id") @db.Uuid
  type         String    @db.VarChar(50) // discovery, classification, full, incremental
  status       String    @default("queued") @db.VarChar(50)
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  stats        Json?     // {assets_found, fields_scanned, classifications_applied, errors}
  errorMessage String?   @map("error_message") @db.Text
  config       Json?
  triggeredBy  String    @map("triggered_by") @db.VarChar(50) // scheduled, manual, event
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scanScope     Json?    @map("scan_scope")       // {includePatterns, excludePatterns, depth}
  discoveryMode String?  @map("discovery_mode") @db.VarChar(50) // full, incremental, targeted, shadow

  // Relations
  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  @@index([tenantId])
  @@index([dataSourceId])
  @@index([status])
  @@map("scan_jobs")
}

// ============================================================================
// Data Discovery & Classification
// ============================================================================

model Asset {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  dataSourceId    String    @map("data_source_id") @db.Uuid
  name            String    @db.VarChar(500)
  type            String    @db.VarChar(50) // table, bucket, collection, etc.
  path            String?   @db.VarChar(2000)
  parentAssetId   String?   @map("parent_asset_id") @db.Uuid
  status          String    @default("active") @db.VarChar(50)
  discoveredAt    DateTime  @default(now()) @map("discovered_at")
  lastScannedAt   DateTime? @map("last_scanned_at")
  rowCountEstimate BigInt?  @map("row_count_estimate")
  sizeBytes       BigInt?   @map("size_bytes")
  schemaSnapshot  Json?     @map("schema_snapshot")
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  ownerEmail      String?   @map("owner_email") @db.VarChar(255)
  lastAccessedAt  DateTime? @map("last_accessed_at")
  lastModifiedBy  String?   @map("last_modified_by") @db.VarChar(255)
  accessPermissions Json?   @map("access_permissions")   // [{principal, type, permissions}]
  activityMetadata  Json?   @map("activity_metadata")    // {readCount, writeCount, lastAccess}
  storageLocation String?   @map("storage_location") @db.VarChar(500)
  encryptionStatus String?  @map("encryption_status") @db.VarChar(50) // encrypted, unencrypted, unknown
  isShadowData    Boolean   @default(false) @map("is_shadow_data")
  isAiDataset     Boolean   @default(false) @map("is_ai_dataset")
  fingerprint     String?   @db.VarChar(128) // Content hash for deduplication
  discoverySource String?   @map("discovery_source") @db.VarChar(50) // connector, manual, inference
  tags            Json?     @default("[]")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  dataSource      DataSource      @relation(fields: [dataSourceId], references: [id])
  parentAsset     Asset?          @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets     Asset[]         @relation("AssetHierarchy")
  fields          AssetField[]
  classifications Classification[]
  riskFindings    RiskFinding[]
  identityAccessMappings IdentityAccessMapping[]
  shadowDataAlerts       ShadowDataAlert[]
  lineageAsSource        DataLineageRecord[] @relation("LineageSource")
  lineageAsTarget        DataLineageRecord[] @relation("LineageTarget")
  attackPathTargets      AttackPath[]

  @@index([tenantId])
  @@index([dataSourceId])
  @@index([type])
  @@index([path])
  @@index([isShadowData])
  @@index([isAiDataset])
  @@map("assets")
}

model AssetField {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  assetId         String @map("asset_id") @db.Uuid
  name            String @db.VarChar(500)
  dataType        String? @map("data_type") @db.VarChar(100)
  ordinalPosition Int?   @map("ordinal_position")
  nullable        Boolean?
  sampleValues    Json?  @map("sample_values") // Redacted/masked
  profilingStats  Json?  @map("profiling_stats")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  asset           Asset            @relation(fields: [assetId], references: [id])
  classifications Classification[]

  @@index([assetId])
  @@index([tenantId])
  @@map("asset_fields")
}

model ClassificationLabel {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String? @map("tenant_id") @db.Uuid // null = system
  name             String  @db.VarChar(255)
  category         String  @db.VarChar(50) // pii, pfi, phi, sensitive, business, public
  sensitivityLevel Int     @map("sensitivity_level") // 1-5
  regulationTags   Json?   @map("regulation_tags") // ["DPDP", "GDPR"]
  detectionPatterns Json?  @map("detection_patterns") // {regex: [], keywords: []}
  mlModelId        String? @map("ml_model_id") @db.VarChar(100)
  schemaHeuristics Json?   @map("schema_heuristics") // {tableNamePatterns, columnNamePatterns, dataTypeHints}
  description      String? @db.Text
  isSystem         Boolean @default(false) @map("is_system")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  classifications Classification[]

  @@index([tenantId])
  @@index([category])
  @@map("classification_labels")
}

model Classification {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  assetFieldId String?  @map("asset_field_id") @db.Uuid
  labelId      String   @map("label_id") @db.Uuid
  confidence   Decimal  @db.Decimal(3, 2) // 0.00 - 1.00
  method       String   @db.VarChar(50) // regex, dictionary, ml, manual
  status       String   @default("auto_applied") @db.VarChar(50)
  modelVersion String?  @map("model_version") @db.VarChar(50)
  evidence     Json?    // {sampleMatches, regexPattern, mlScore}
  scanJobId    String?  @map("scan_job_id") @db.Uuid
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  asset      Asset              @relation(fields: [assetId], references: [id])
  assetField AssetField?        @relation(fields: [assetFieldId], references: [id])
  label      ClassificationLabel @relation(fields: [labelId], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([labelId])
  @@index([status])
  @@map("classifications")
}

// ============================================================================
// DSPM: Risk Findings
// ============================================================================

model RiskFinding {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  source               String    @db.VarChar(50) // dspm, dpia, tprm, compliance, manual
  category             String    @db.VarChar(50) // exposure, access, encryption, retention, etc.
  severity             String    @db.VarChar(50) // critical, high, medium, low, info
  title                String    @db.VarChar(500)
  description          String    @db.Text
  assetId              String?   @map("asset_id") @db.Uuid
  dataSourceId         String?   @map("data_source_id") @db.Uuid
  status               String    @default("open") @db.VarChar(50)
  riskScore            Decimal   @map("risk_score") @db.Decimal(5, 2) // 0-100
  remediationGuidance  String?   @map("remediation_guidance") @db.Text
  evidence             Json?
  assignedTo           String?   @map("assigned_to") @db.Uuid
  dueDate              DateTime? @map("due_date") @db.Date
  resolvedAt           DateTime? @map("resolved_at")
  scanJobId            String?   @map("scan_job_id") @db.Uuid
  riskBreakdown        Json?     @map("risk_breakdown")      // Full scoring breakdown
  linkedGraphNodeId    String?   @map("linked_graph_node_id") @db.Uuid
  autoRemediation      Json?     @map("auto_remediation")    // Suggested remediation actions
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Relations
  asset              Asset?              @relation(fields: [assetId], references: [id])
  remediationActions RemediationAction[]

  @@index([tenantId])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([assetId])
  @@index([riskScore])
  @@map("risk_findings")
}

// ============================================================================
// Consent Management
// ============================================================================

model ProcessingPurpose {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String  @db.VarChar(255)
  description     String? @db.Text
  lawfulBasis     String  @map("lawful_basis") @db.VarChar(50)
  isActive        Boolean @default(true) @map("is_active")
  parentPurposeId String? @map("parent_purpose_id") @db.Uuid
  linkedRopaId    String? @map("linked_ropa_id") @db.Uuid
  retentionDays   Int?    @map("retention_days")
  jurisdictions   Json?   // Applicable jurisdictions
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  consentRecords ConsentRecord[]

  @@index([tenantId])
  @@map("processing_purposes")
}

model ConsentNotice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  version     Int       @default(1)
  status      String    @default("draft") @db.VarChar(50) // draft, published, archived
  content     Json      // Structured notice content
  purposes    Json      // Array of purpose definitions
  publishedAt DateTime? @map("published_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  consentRecords ConsentRecord[]

  @@index([tenantId])
  @@map("consent_notices")
}

model DataSubject {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  externalId         String?   @map("external_id") @db.VarChar(500)
  emailHash          String?   @map("email_hash") @db.VarChar(64)
  identityAttributes Json      @map("identity_attributes") // Encrypted
  status             String    @default("active") @db.VarChar(50)
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at")
  lastActivityAt     DateTime? @map("last_activity_at")
  jurisdiction       String?   @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  consentRecords ConsentRecord[]
  dsarRequests   DsarRequest[]

  @@index([tenantId])
  @@index([emailHash])
  @@index([externalId])
  @@map("data_subjects")
}

model ConsentRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  dataSubjectId  String    @map("data_subject_id") @db.Uuid
  noticeId       String    @map("notice_id") @db.Uuid
  noticeVersion  Int       @map("notice_version")
  purposeId      String    @map("purpose_id") @db.Uuid
  status         String    @db.VarChar(50) // granted, denied, revoked, expired
  grantedAt      DateTime? @map("granted_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime? @map("expires_at")
  channel        String    @db.VarChar(100) // web, mobile, api, email, offline
  ipAddress      String?   @map("ip_address") @db.VarChar(45) // Encrypted
  userAgent      String?   @map("user_agent") @db.Text
  proof          Json?
  lawfulBasis    String    @map("lawful_basis") @db.VarChar(50)
  linkedDsarId   String?   @map("linked_dsar_id") @db.Uuid
  linkedRopaId   String?   @map("linked_ropa_id") @db.Uuid
  jurisdiction   String?   @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  dataSubject DataSubject      @relation(fields: [dataSubjectId], references: [id])
  notice      ConsentNotice    @relation(fields: [noticeId], references: [id])
  purpose     ProcessingPurpose @relation(fields: [purposeId], references: [id])

  @@index([tenantId])
  @@index([dataSubjectId])
  @@index([purposeId])
  @@index([status])
  @@map("consent_records")
}

// ============================================================================
// DSAR (Data Subject Access Requests)
// ============================================================================

model DsarRequest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  referenceNumber    String    @map("reference_number") @db.VarChar(50)
  dataSubjectId      String?   @map("data_subject_id") @db.Uuid
  type               String    @db.VarChar(50) // access, deletion, correction, portability, objection, restriction
  status             String    @default("submitted") @db.VarChar(50)
  channel            String    @db.VarChar(100)
  submittedAt        DateTime  @default(now()) @map("submitted_at")
  verifiedAt         DateTime? @map("verified_at")
  dueDate            DateTime  @map("due_date")
  completedAt        DateTime? @map("completed_at")
  requestorInfo      Json      @map("requestor_info") // Encrypted
  identityProof      Json?     @map("identity_proof")
  notes              String?   @db.Text
  assignedTo         String?   @map("assigned_to") @db.Uuid
  legalHold          Boolean   @default(false) @map("legal_hold")
  rejectionReason    String?   @map("rejection_reason") @db.Text
  responsePackageUrl String?   @map("response_package_url") @db.VarChar(2000)
  discoveredDataSources Json?  @map("discovered_data_sources") // [{sourceId, assetCount, status}]
  responseMetadata      Json?  @map("response_metadata")       // {packageSize, formatType, generatedAt}
  deletionVerification  Json?  @map("deletion_verification")   // {verified, verifiedAt, verifiedBy, evidence}
  automationLevel       String? @map("automation_level") @db.VarChar(50) // manual, semi_auto, full_auto
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  dataSubject DataSubject? @relation(fields: [dataSubjectId], references: [id])

  @@unique([tenantId, referenceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@map("dsar_requests")
}

// ============================================================================
// Privacy Risk Assessment (DPIA/PIA)
// ============================================================================

model PrivacyAssessment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  title                 String    @db.VarChar(500)
  type                  String    @db.VarChar(50) // dpia, pia, tia, lia
  status                String    @default("draft") @db.VarChar(50)
  templateId            String?   @map("template_id") @db.Uuid
  ownerId               String    @map("owner_id") @db.Uuid
  reviewerId            String?   @map("reviewer_id") @db.Uuid
  processingDescription String    @map("processing_description") @db.Text
  dataCategories        Json      @map("data_categories")
  riskItems             Json      @default("[]") @map("risk_items")
  overallRiskScore      Decimal?  @map("overall_risk_score") @db.Decimal(5, 2)
  overallRiskLevel      String?   @map("overall_risk_level") @db.VarChar(50)
  approvedAt            DateTime? @map("approved_at")
  approvedBy            String?   @map("approved_by") @db.Uuid
  nextReviewDate        DateTime? @map("next_review_date") @db.Date
  linkedRopaId          String?   @map("linked_ropa_id") @db.Uuid
  evidenceIds           Json?     @map("evidence_ids")
  triggerType           String?   @map("trigger_type") @db.VarChar(50)  // manual, automated, regulatory
  triggerReason         String?   @map("trigger_reason") @db.Text
  linkedVendorId        String?   @map("linked_vendor_id") @db.Uuid
  linkedConsentIds      Json?     @map("linked_consent_ids")
  approvalWorkflowId    String?   @map("approval_workflow_id") @db.Uuid
  privacyRiskScore      Json?     @map("privacy_risk_score")   // Structured privacy-specific risk breakdown
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@map("privacy_assessments")
}

// ============================================================================
// Incident & Breach Management
// ============================================================================

model Incident {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  referenceNumber         String    @map("reference_number") @db.VarChar(50)
  title                   String    @db.VarChar(500)
  status                  String    @default("reported") @db.VarChar(50)
  severity                String    @db.VarChar(50)
  isPersonalDataBreach    Boolean?  @map("is_personal_data_breach")
  detectedAt              DateTime  @map("detected_at")
  reportedAt              DateTime  @default(now()) @map("reported_at")
  containedAt             DateTime? @map("contained_at")
  resolvedAt              DateTime? @map("resolved_at")
  description             String    @db.Text
  affectedAssets          Json?     @map("affected_assets")
  affectedDataTypes       Json?     @map("affected_data_types")
  estimatedSubjectsAffected Int?    @map("estimated_subjects_affected")
  rootCause               String?   @map("root_cause") @db.Text
  remediationActions      Json?     @map("remediation_actions")
  regulatoryNotifications Json?     @map("regulatory_notifications")
  assignedTo              String?   @map("assigned_to") @db.Uuid
  forensicEvidenceIds     Json?     @map("forensic_evidence_ids")
  detectionSource         String?   @map("detection_source") @db.VarChar(50) // manual, automated, external
  regulatoryDeadline      DateTime? @map("regulatory_deadline")
  notificationsSent       Json?     @map("notifications_sent") // [{authority, sentAt, confirmationId}]
  dataSubjectNotified     Boolean   @default(false) @map("data_subject_notified")
  linkedAttackPathId      String?   @map("linked_attack_path_id") @db.Uuid
  linkedLineageIds        Json?     @map("linked_lineage_ids")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  @@unique([tenantId, referenceNumber])
  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@map("incidents")
}

// ============================================================================
// Retention & Governance
// ============================================================================

model RetentionPolicy {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  name                  String   @db.VarChar(255)
  description           String?  @db.Text
  recordCategory        String   @map("record_category") @db.VarChar(255)
  retentionPeriodDays   Int      @map("retention_period_days")
  actionOnExpiry        String   @map("action_on_expiry") @db.VarChar(50) // delete, archive, review, anonymize
  legalBasis            String?  @map("legal_basis") @db.Text
  applicableRegulations Json?    @map("applicable_regulations")
  status                String   @default("draft") @db.VarChar(50)
  appliesTo             Json?    @map("applies_to") // Asset/data source filters
  appliedAssetCount     Int      @default(0) @map("applied_asset_count")
  lastEnforcedAt        DateTime? @map("last_enforced_at")
  nextEnforcementAt     DateTime? @map("next_enforcement_at")
  createdBy             String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([status])
  @@map("retention_policies")
}

// ============================================================================
