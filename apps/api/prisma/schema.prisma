  @@index([assetId])
  @@index([identityType])
  @@index([isExcessive])
  @@index([isInactive])
  @@map("identity_access_mappings")
}

// ============================================================================
// Shadow Data Alerts (Module 9)
// ============================================================================

model ShadowDataAlert {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  alertType      String    @map("alert_type") @db.VarChar(50) // duplicate, orphaned, stale_export, shadow_saas, backup_copy, ai_sandbox
  assetId        String    @map("asset_id") @db.Uuid
  relatedAssetId String?   @map("related_asset_id") @db.Uuid
  severity       String    @db.VarChar(20)
  description    String    @db.Text
  evidence       Json
  status         String    @default("open") @db.VarChar(50) // open, investigating, resolved, false_positive
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([tenantId])
  @@index([alertType])
  @@index([status])
  @@map("shadow_data_alerts")
}

// ============================================================================
// Data Lineage (Module 10)
// ============================================================================

model DataLineageRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  sourceAssetId  String    @map("source_asset_id") @db.Uuid
  targetAssetId  String    @map("target_asset_id") @db.Uuid
  transformType  String    @map("transform_type") @db.VarChar(50) // copy, etl, export, share, api_sync, backup, ai_training
  dataCategories Json      @map("data_categories")
  isActive       Boolean   @default(true) @map("is_active")
  discoveredAt   DateTime  @default(now()) @map("discovered_at")
  lastObservedAt DateTime? @map("last_observed_at")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sourceAsset Asset @relation("LineageSource", fields: [sourceAssetId], references: [id])
  targetAsset Asset @relation("LineageTarget", fields: [targetAssetId], references: [id])

  @@index([tenantId])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([transformType])
  @@map("data_lineage_records")
}

// ============================================================================
// Attack Paths (Module 11)
// ============================================================================

model AttackPath {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  title         String    @db.VarChar(500)
  severity      String    @db.VarChar(20)
  score         Decimal   @db.Decimal(5, 2)
  pathNodes     Json      @map("path_nodes")    // [{nodeType, nodeId, label, vulnerability}]
  entryPoint    Json      @map("entry_point")   // {type, identifier, description}
  targetAssetId String    @map("target_asset_id") @db.Uuid
  targetDataTypes Json    @map("target_data_types")
  status        String    @default("active") @db.VarChar(50) // active, mitigated, false_positive
  mitigatedAt   DateTime? @map("mitigated_at")
  mitigatedBy   String?   @map("mitigated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  targetAsset Asset @relation(fields: [targetAssetId], references: [id])

  @@index([tenantId])
  @@index([severity])
  @@index([status])
  @@map("attack_paths")
}

