// ============================================================================
// Workflow Tracking
// ============================================================================

model Workflow {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  type               String    @db.VarChar(50) // dsar, breach, dpia, retention, vendor_review
  status             String    @default("active") @db.VarChar(50)
  entityType         String    @map("entity_type") @db.VarChar(100)
  entityId           String    @map("entity_id") @db.Uuid
  currentStep        String?   @map("current_step") @db.VarChar(100)
  temporalWorkflowId String?   @map("temporal_workflow_id") @db.VarChar(500)
  triggerType        String?   @map("trigger_type") @db.VarChar(50) // manual, event, schedule, threshold
  triggerConfig      Json?     @map("trigger_config")
  priority           String?   @db.VarChar(20) // critical, high, medium, low
  assigneeId         String?   @map("assignee_id") @db.Uuid
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  tasks WorkflowTask[]

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([status])
  @@map("workflows")
}

model WorkflowTask {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  workflowId      String    @map("workflow_id") @db.Uuid
  taskType        String    @map("task_type") @db.VarChar(50) // review, approve, execute, notify, verify
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  ownerId         String    @map("owner_id") @db.Uuid
  assigneeId      String?   @map("assignee_id") @db.Uuid
  priority        String    @default("medium") @db.VarChar(20) // critical, high, medium, low
  status          String    @default("pending") @db.VarChar(50) // pending, in_progress, completed, blocked, skipped
  dueDate         DateTime? @map("due_date")
  completedAt     DateTime? @map("completed_at")
  auditEvidence   Json?     @map("audit_evidence")
  metadata        Json?
  dependsOnTaskId String?   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  workflow      Workflow      @relation(fields: [workflowId], references: [id])
  dependsOnTask WorkflowTask? @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependentTasks WorkflowTask[] @relation("TaskDependency")

  @@index([tenantId])
  @@index([workflowId])
  @@index([status])
  @@index([assigneeId])
  @@map("workflow_tasks")
}

// ============================================================================
// Security: API Keys, SCIM Tokens
// ============================================================================

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  keyHash     String    @map("key_hash") @db.VarChar(64) // SHA-256 of the API key
  keyPrefix   String    @map("key_prefix") @db.VarChar(8) // First 8 chars for identification
  permissions Json      // Permission strings this key is authorized for
  scopes      Json?     // Optional ABAC scopes
  createdBy   String    @map("created_by") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@map("api_keys")
}

model ScimToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tokenHash])
  @@map("scim_tokens")
}

